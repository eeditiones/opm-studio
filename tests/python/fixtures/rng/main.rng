<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
  xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
  xmlns:xlink="http://www.w3.org/1999/xlink">
  <start><ref name="doc"/></start>
  <include href="base.rng">
    <!-- replaces b and i -->
    <define name="inline"><element name="em"><text/></element></define>
  </include>
  <define name="block" combine="choice"><ref name="section"/></define>
  <define name="block" combine="choice"><externalRef href="list.rng"/></define>
  <define name="doc">
    <element name="doc">
      <a:documentation>(document) the root of a test document. [1.2. Documents 3.4. Roots]</a:documentation>
      <ref name="title"/>
      <zeroOrMore><ref name="block"/></zeroOrMore>
    </element>
  </define>
  <define name="section">
    <element name="section">
      <a:documentation>A section. It may hold further sections.</a:documentation>
      <optional>
        <attribute name="type">
          <a:documentation>the kind of section</a:documentation>
          <choice>
            <value>chapter</value>
            <a:documentation>a chapter</a:documentation>
            <value>appendix</value>
          </choice>
        </attribute>
      </optional>
      <optional><attribute name="href" ns="http://www.w3.org/1999/xlink"/></optional>
      <optional><attribute name="id"/></optional>
      <!-- a second pattern for title, with an attribute the first lacks -->
      <element name="title"><attribute name="level"/><text/></element>
      <zeroOrMore><ref name="block"/></zeroOrMore>
    </element>
  </define>
  <define name="title">
    <element name="title">
      <optional><attribute name="id"><a:documentation>identifies the title</a:documentation></attribute></optional>
      <text/>
    </element>
  </define>
  <define name="anything">
    <element><anyName/><text/></element>
  </define>
</grammar>
